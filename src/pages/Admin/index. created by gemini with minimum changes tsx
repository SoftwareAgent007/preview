		const onDragEnd = (result: DropResult) => {
        const { source, destination, draggableId: guildId } = result;

        if (!destination) return;

        const sourceId = source.droppableId;
        const destId = destination.droppableId;

        // Prevent dropping onto itself or invalid moves
        if (sourceId === destId) return;

        // --- Optimistic UI Updates ---
        let guildToMove: Guild | undefined;
        let sourceGroupIndex = -1;
        let destGroupIndex = -1;

        // Find the guild and source/destination groups
        if (sourceId === "availableGuilds") {
            guildToMove = availableGuilds.find(g => g.id === guildId);
        } else {
            sourceGroupIndex = guildGroups.findIndex(g => g.id === sourceId);
            if (sourceGroupIndex !== -1) {
                guildToMove = guildGroups[sourceGroupIndex].guilds.find(g => g.id === guildId);
            }
        }

        if (!guildToMove) return; // Should not happen if draggableId is correct

        if (destId !== "availableGuilds") {
            destGroupIndex = guildGroups.findIndex(g => g.id === destId);
            if (destGroupIndex !== -1) {
                // Check if guild already exists in destination group (by name or ID)
                if (guildGroups[destGroupIndex].guilds.some(g => g.id === guildId || g.name === guildToMove?.name)) {
                    toast({ title: "Action restricted", description: "This guild is already in the destination group.", variant: "destructive" });
                    return;
                }
            } else {
                 return; // Invalid destination group ID
            }
        }

        // Perform optimistic update on local state
        const newAvailableGuilds = [...availableGuilds];
        const newGuildGroups = [...guildGroups];

        // Remove from source
        if (sourceId === "availableGuilds") {
            const idx = newAvailableGuilds.findIndex(g => g.id === guildId);
            if (idx > -1) newAvailableGuilds.splice(idx, 1);
        } else if (sourceGroupIndex !== -1) {
            const guilds = [...newGuildGroups[sourceGroupIndex].guilds];
            const idx = guilds.findIndex(g => g.id === guildId);
            if (idx > -1) guilds.splice(idx, 1);
            newGuildGroups[sourceGroupIndex] = { ...newGuildGroups[sourceGroupIndex], guilds };
        }

        // Add to destination
        if (destId === "availableGuilds") {
            newAvailableGuilds.splice(destination.index, 0, guildToMove); // Add to available
        } else if (destGroupIndex !== -1) {
            const guilds = [...newGuildGroups[destGroupIndex].guilds];
            guilds.splice(destination.index, 0, guildToMove); // Insert at specific index
             newGuildGroups[destGroupIndex] = { ...newGuildGroups[destGroupIndex], guilds, expanded: true }; // Ensure group is expanded
        }
        
        // Update state immediately for responsive UI
        setAvailableGuilds(newAvailableGuilds);
        setGuildGroups(newGuildGroups);

        // --- Call the Mutation ---
        // Determine sourceGroupId and destGroupId for the API call
        const sourceGroupId = sourceId === "availableGuilds" ? null : sourceId;
        const destGroupId = destId === "availableGuilds" ? null : destId;

        moveGuild({ guildId, sourceGroupId, destGroupId }, {
            onSuccess: (updatedData) => {
                // API call succeeded, local state is already updated optimistically.
                // Optionally, refresh data or update based on response if needed.
                console.log("Guild moved successfully on server", updatedData);
                toast({ title: "Guild Moved", description: `Moved ${guildToMove?.name}.`});
            },
            onError: (error) => {
                console.error("Failed to move guild:", error);
                toast({ title: "Error Moving Guild", description: "Failed to update guild position. Reverting changes.", variant: "destructive" });
                // Revert optimistic update on error
                setAvailableGuilds(availableGuilds); // Revert to original state before drag
                setGuildGroups(guildGroups);      // Revert to original state before drag
            }
        });

