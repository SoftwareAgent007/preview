                                                            // Edit Input Mode
                                                             <div className="flex items-center gap-1 flex-1">
                                                                <Input
                                                                    value={newGroupName}
                                                                    onChange={(e) => setNewGroupName(e.target.value)}
                                                                    className="h-8 flex-1" // Make input take space
                                                                    disabled={isUpdatingGroup}
                                                                />
                                                                <Button size="icon" variant="ghost" className="h-8 w-8" onClick={() => handleUpdateGroup(group.id, newGroupName)} disabled={isUpdatingGroup || !newGroupName.trim()}>
                                                                    <Check size={16} className={isUpdatingGroup ? "animate-spin" : ""} />
                                                                </Button>
                                                                 <Button size="icon" variant="ghost" className="h-8 w-8" onClick={() => { setEditingGroupId(null); setNewGroupName(""); }} disabled={isUpdatingGroup}>
                                                                     <X size={16} />
                                                                 </Button>
                                                            </div>
                                                        ) : (
                                                            // Display Mode
                                                            <>
                                                                <button onClick={() => toggleGroupExpansion(group.id)} className="flex-shrink-0">
                                                                    {group.expanded ? <ChevronDown size={20} /> : <ChevronRight size={20} />}
                                                                </button>
                                                                <span className="font-semibold truncate" title={group.name}>{group.name}</span>
                                                            </>
                                                        )}
                                                    </div>
                                                    {/* Action Buttons (Edit/Delete) - only if not editing */}
                                                     {editingGroupId !== group.id && (
                                                         <div className="flex items-center gap-1 flex-shrink-0">
                                                             <Button size="icon" variant="ghost" className="h-8 w-8" onClick={() => { setEditingGroupId(group.id); setNewGroupName(group.name); }}>
                                                                 <Edit size={16} />
                                                             </Button>
                                                             <Dialog>
                                                                 <DialogTrigger asChild>
                                                                      <Button size="icon" variant="ghost" className="h-8 w-8 text-red-600 hover:text-red-700" disabled={isDeletingGroup}>
                                                                          {isDeletingGroup && group.id === editingGroupId ? <Check className="animate-spin" size={16} /> : <Trash2 size={16} />}
                                                                      </Button>
                                                                 </DialogTrigger>
                                                                 <DialogContent>
                                                                      <DialogHeader>
                                                                           <DialogTitle>Delete Group "{group.name}"?</DialogTitle>
                                                                           <DialogDescription>
                                                                               This action cannot be undone. Guilds in this group will be moved to Available Guilds.
                                                                           </DialogDescription>
                                                                       </DialogHeader>
                                                                       <DialogFooter>
                                                                           <Button variant="outline" onClick={(e) => e.stopPropagation()}>Cancel</Button> {/* Stop propagation */}
                                                                           <Button variant="destructive" onClick={() => handleDeleteGroup(group.id)} disabled={isDeletingGroup}>
                                                                               {isDeletingGroup ? "Deleting..." : "Delete Group"}
                                                                           </Button>
                                                                       </DialogFooter>
                                                                 </DialogContent>
                                                             </Dialog>
                                                         </div>
                                                     )}
                                                </div>
                                                {/* Draggable Guilds within the Group */}
                                                <AnimatePresence>
                                                    {group.expanded && (
                                                        <motion.div
                                                            initial={{ height: 0, opacity: 0 }}
                                                            animate={{ height: "auto", opacity: 1 }}
                                                            exit={{ height: 0, opacity: 0 }}
                                                            transition={{ duration: 0.2 }}
                                                            className="relative pl-6 mt-2 min-h-[10px]" // Ensure some min-height for drop target
                                                        >
                                                            <div className="absolute left-1 top-0 bottom-0 w-[2px] bg-gray-300"></div>
                                                            {group.guilds.length === 0 && <div className="text-xs text-gray-500 italic py-2">Drop guilds here</div>}
                                                            {group.guilds.map((guild, index) => (
                                                                <Draggable key={guild.id} draggableId={guild.id} index={index}>
																																	{(provided: DraggableProvided) => (
                                                                        <div
                                                                            ref={provided.innerRef}
                                                                            {...provided.draggableProps}
                                                                            {...provided.dragHandleProps}
                                                                            className="bg-white p-3 rounded-lg mb-2 shadow-sm cursor-grab active:cursor-grabbing relative border border-gray-200"
                                                                        >
                                                                            <div className="absolute left-[-20px] top-[calc(50%-1px)] w-[20px] h-[2px] bg-gray-300"></div>
                                                                            <div className="flex items-center justify-between">
                                                                                <span className="text-sm">{guild.name}</span>
                                                                                <div className="flex items-center gap-2">
                                                                                    <Badge variant="secondary" className="text-xs">{guild.members} members</Badge>
                                                                                     <button
                                                                                         onClick={() => deleteGuildFromGroup(group.id, guild.id)}
                                                                                         className="text-gray-400 hover:text-red-600 p-1 -m-1"
                                                                                         title="Remove from group"
                                                                                         disabled={isMovingGuild} // Disable while any move is in progress
                                                                                     >
                                                                                        <X size={14} />
                                                                                     </button>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    )}
                                                                </Draggable>
                                                            ))}
                                                             {provided.placeholder} {/* Placeholder for react-beautiful-dnd */}
                                                        </motion.div>
                                                    )}
                                                </AnimatePresence>
                                            </motion.div>
                                        )}
                                    </Droppable>
                                ))}
                            </Card>
                        </motion.div>

                        {/* Available Guilds Column */}
                        <motion.div variants={itemVariants}>
                            <Card className="relative p-6 h-full">
                                <h3 className="text-xl font-semibold mb-4">Available Guilds</h3>
                                <Droppable droppableId="availableGuilds">
                                    {(provided: DroppableProvided) => (
                                        <div
                                            {...provided.droppableProps}
                                            ref={provided.innerRef}
                                            className="bg-gray-50 p-4 rounded border border-dashed border-gray-300 min-h-[100px]" // Style drop area
                                        >
                                             {availableGuilds.length === 0 && <div className="text-sm text-gray-500 italic text-center py-4">No available guilds</div>}
                                            {availableGuilds.map((guild, index) => (
                                                <Draggable
                                                    key={guild.id}
                                                    draggableId={guild.id}
                                                    index={index}
                                                    // isDragDisabled={isGuildInAnyGroup(guild.id)} // Disable if needed, handled by drop logic now
                                                >
                                                    {(provided, snapshot) => (
                                                        <div
                                                            ref={provided.innerRef}
                                                            {...provided.draggableProps}
                                                            {...provided.dragHandleProps}
                                                            className={`bg-white p-3 rounded-lg mb-2 shadow-sm border border-gray-200 cursor-grab active:cursor-grabbing ${snapshot.isDragging ? 'opacity-75 shadow-lg' : ''}`}
                                                        >
                                                            <div className="flex items-center justify-between">
                                                                <div className="flex items-center gap-2">
                                                                    <GripVertical className="w-4 h-4 text-gray-400 flex-shrink-0" />
                                                                    <span className="text-sm">{guild.name}</span>
                                                                </div>
                                                                <Badge variant="secondary" className="text-xs">{guild.members} members</Badge>
                                                            </div>
                                                        </div>
                                                    )}
                                                </Draggable>
                                            ))}
                                            {provided.placeholder}
                                        </div>
                                    )}
                                </Droppable>
                            </Card>
                        </motion.div>
                    </div>
                </DragDropContext>

                {/* --- Organization Structure --- */}
                <OrganizationStructure
                    organizations={organizations} // Pass state or fetched data
                    // isLoading={isLoadingOrganizations} // Use actual loading state
                    isLoading={false} // Placeholder
                    className="mb-6"
                />

                {/* --- Guilds Management Table --- */}
                 <GuildsManagement
                     guilds={guildsForManagement} // Use separate state/fetched data for this table
                     organizations={organizationOptions.filter(o => o !== "All Organizations")} // Pass actual org names
                     groups={groupOptions.filter(g => g !== "All Groups")} // Pass actual group names
                     onUpdate={handleGuildUpdate} // Use useCallback wrapped handler
                     onDelete={handleGuildDelete} // Use useCallback wrapped handler
                     isLoading={isUpdatingGuild || isDeletingGuild} // Reflect loading state
                     className="mb-6"
                 />
            </div>
        </motion.div>
    );
};

export default AdminPanel;